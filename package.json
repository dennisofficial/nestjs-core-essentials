{
  "name": "@workspace/nestjs-core",
  "version": "1.0.1",
  "description": "Essential NestJS utilities and decorators",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./src/index.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm tsup",
    "dev": "nodemon"
  },
  "peerDependencies": {
    "@nestjs/bullmq": ">=11.0.0",
    "@nestjs/common": ">=11.0.0",
    "@nestjs/config": ">=4.0.0",
    "@nestjs/core": ">=11.0.0",
    "@nestjs/mongoose": ">=11.0.0",
    "@nestjs/typeorm": ">=11.0.0",
    "express": ">=4.0.0",
    "reflect-metadata": ">=0.1.0",
    "rxjs": ">=7.0.0",
    "typeorm": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/bullmq": {
      "optional": true
    },
    "@nestjs/config": {
      "optional": true
    },
    "@nestjs/mongoose": {
      "optional": true
    },
    "@nestjs/typeorm": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/typeorm": "^11.0.1",
    "@types/express": "^5.0.6",
    "class-validator": "^0.15.1",
    "mongodb": "^6.21.0",
    "mongoose": "^9.4.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsup": "^8.5.0",
    "typeorm": "^0.3.28",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "pretty-ms": "^9.3.0"
  }
}
